{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"], "env": ["SITE_INDEXABLE"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "@ironnews/web#typecheck": { "dependsOn": ["^build", "@ironnews/web#build"] },
    "test": { "dependsOn": ["^build"] }
  }
}
