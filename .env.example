# IRON CYBER NEWS — variáveis de ambiente (sem valores). Detalhes em docs/ARQUITETURA-IRON-CYBER-NEWS.md §10.2
# Copie para .env.local (dev). NUNCA commite valores reais.

# ---------- apps/web (Vercel) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
REVALIDATE_SECRET=
# Cifra dos tokens OAuth (AES-256-GCM). Gerar: openssl rand -base64 32. O MESMO valor vai no executor.
TOKEN_ENC_KEY=
# Assina o state do OAuth (mín. 32 caracteres). Gerar: openssl rand -base64 48
OAUTH_STATE_SECRET=
# Instagram API com login do Instagram (painel → Integrações). Redirect: <site>/admin/integracoes/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=

# ---------- apps/executor (VPS: /etc/ironnews/executor.env) ----------
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=8080
BRAND_SLUG=iron
# DATABASE_URL (role ironnews_exec via pooler, sslmode=require)
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SEC=60
PUBLISH_DRY_RUN=1
# Instagram: MESMO TOKEN_ENC_KEY da Vercel (sem ela, a publicação no Instagram fica desligada)
TOKEN_ENC_KEY=
INSTAGRAM_GRAPH_VERSION=v23.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=
REVALIDATE_URL=
RENDER_URL=
RENDER_SECRET=
ANTHROPIC_API_KEY=
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_FALLBACK=claude-sonnet-5-5
LLM_PRICE_TABLE=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
HEYGEN_API_KEY=
NVD_API_KEY=
GITHUB_TOKEN=
LINKEDIN_API_VERSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- VPS: /etc/ironnews/compose.env ----------
GHCR_OWNER=

# ---------- VPS: /etc/ironnews/deploy.env (só o container de deploy) ----------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- Workers (wrangler secret put) ----------
# edge-hooks: SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY HEYGEN_WEBHOOK_SECRET META_APP_SECRET
# og-render:  RENDER_SECRET
